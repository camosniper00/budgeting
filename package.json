{
  "name": "mint-budget",
  "version": "1.0.0",
  "private": true,
  "description": "Personal budgeting app - Mint replacement",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && node index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "db:seed": "cd server && node seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "ofx-js": "^0.2.0",
    "sql.js": "^1.14.0",
    "uuid": "^9.0.0"
  }
}
